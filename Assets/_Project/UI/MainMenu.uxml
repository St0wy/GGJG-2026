<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
        <ui:VisualElement style="flex-grow: 1; width: 30%;"/>
        <ui:VisualElement name="Main" style="flex-grow: 1; width: 40%; flex-direction: column;">
            <ui:Label text="Main Menu" name="MainMenu-Label" style="width: 100%; height: 50%; -unity-text-align: lower-center; border-bottom-width: 16px; font-size: 64px; -unity-font-style: bold;"/>
            <ui:Button text="Play" name="Play-Btn"/>
            <ui:Button text="About" name="About-Btn"/>
            <ui:Button text="Exit" name="Exit-Btn"/>
        </ui:VisualElement>
        <ui:VisualElement style="flex-grow: 1; width: 30%;"/>
    </ui:VisualElement>
</ui:UXML>
